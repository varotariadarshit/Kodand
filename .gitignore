__pycache__/
*.py[oc]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log
# the tracked pins are requirements.txt (pip format, which install.sh and scanners read); a uv
# lockfile is only a local tool for refreshing them (see CONTRIBUTING.md)
uv.lock

# scan output (generated, keep the folder via .gitkeep)
output/*
!output/.gitkeep

# local Claude Code session state — machine/session-specific, not project config
.claude/settings.local.json
.claude/scheduled_tasks.lock
